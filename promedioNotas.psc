Algoritmo promedioNotas
	Definir nota1 Como Real
	Definir nota2 Como Real
	Definir nota3 Como Real
	Definir promedio Como Real
	//entrada
	Escribir "Indique la nota 1"
	leer nota1
	
	Escribir "Indique la nota 2"
	leer nota2
	
	Escribir "Indique la nota 3"
	leer nota3
	
	//Proceso 
	
	promedio = (nota1 + nota2 + nota3)/3
	
	
	//salida
	
	Imprimir "Su promedio es de: " promedio
	
FinAlgoritmo
